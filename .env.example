# Copy this file to .env and fill in real values for local dev / deployment.
# Every "optional" value below can stay blank — the corresponding feature runs
# in a clearly-labeled mock mode until you supply a real key.

# ---- Core (required) ----
DATABASE_URL="postgresql://user@localhost:5433/reviewengine?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
INTEGRATION_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-string"

# ---- Background jobs (Vercel Cron -> /api/cron/tick). Required in production. ----
CRON_SECRET=""

# ---- Google (OAuth + Places). Leave blank to run in mock mode. ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PLACES_API_KEY=""

# ---- Email provider (Resend). Leave blank to run in mock/simulated mode. ----
RESEND_API_KEY=""
EMAIL_FROM="Review Engine <notifications@reviewengine.app>"

# ---- SMS / WhatsApp (Twilio). Leave blank to run in mock/simulated mode. ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# ---- AI insights (Anthropic). Leave blank to fall back to heuristic sentiment. ----
ANTHROPIC_API_KEY=""

# ---- Billing (Stripe). Leave blank to run in dev-only fake billing mode. ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
